# Resend (required for live email delivery)
RESEND_API_KEY=re_your_api_key_here

# Sender shown in outbound emails (use onboarding@resend.dev for Resend sandbox)
RESEND_FROM=Loop <onboarding@resend.dev>

# Public app URL used in verification and reset links
APP_BASE_URL=http://localhost:5173

# Express server (self-hosted / Docker)
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=0
